{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 15,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "cmake-pedantic",
      "hidden": true,
      "warnings": {
        "dev": false,
        "deprecated": false,
        "uninitialized": false,
        "unusedCli": false,
        "systemVars": false
      },
      "errors": {
        "dev": false,
        "deprecated": false
      }
    },
    {
      "name": "ci-std",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_CXX_STANDARD": "17",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON"
      }
    },
    {
      "name": "flags-windows",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "/sdl /guard:cf /utf-8 /W4 /permissive- /Zc:__cplusplus /EHsc",
        "CMAKE_EXE_LINKER_FLAGS": "/machine:x64 /guard:cf"
      }
    },
    {
      "name": "flags-mingw",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-D_FORTIFY_SOURCE=2 -O2 -fstack-protector-strong -Wall -Wextra -Wpedantic",
        "CMAKE_EXE_LINKER_FLAGS": "-Wl,--as-needed"
      }
    },
    {
      "name": "ci-win64",
      "inherits": ["flags-windows", "ci-std", "cmake-pedantic"],
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/ci-win64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ci-mingw",
      "inherits": ["flags-mingw", "ci-std", "cmake-pedantic"],
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ci-mingw",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "C:/msys64/mingw64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/msys64/mingw64/bin/g++.exe"
      }
    },
    {
      "name": "flags-linux",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-D_FORTIFY_SOURCE=2 -O2 -Wall -Wextra -Wpedantic"
      }
    },
    {
      "name": "ci-linux",
      "inherits": ["flags-linux", "ci-std", "cmake-pedantic"],
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ci-linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ci-sanitize",
      "inherits": ["ci-linux"],
      "binaryDir": "${sourceDir}/build/sanitize",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Sanitize",
        "CMAKE_CXX_FLAGS_SANITIZE": "-O2 -g -fsanitize=address,undefined -fno-omit-frame-pointer -fno-common",
        "CMAKE_EXE_LINKER_FLAGS_SANITIZE": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS_SANITIZE": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "profile-mingw",
      "inherits": ["flags-mingw", "ci-std", "cmake-pedantic"],
      "binaryDir": "${sourceDir}/build/profile-mingw",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "-pg -no-pie -O2 -g -Wall -Wextra -Wpedantic",
        "CMAKE_EXE_LINKER_FLAGS": "-pg -no-pie -static"
      }
    },
    {
      "name": "Release-LTO",
      "displayName": "Release with Link-Time Optimization",
      "description": "Enables -flto for cross-TU optimization of videopac_core and videopac_libretro.",
      "inherits": ["flags-mingw", "ci-std", "cmake-pedantic"],
      "binaryDir": "${sourceDir}/build/release-lto",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "-flto -O2 -Wall -Wextra -Wpedantic",
        "CMAKE_EXE_LINKER_FLAGS": "-flto",
        "CMAKE_SHARED_LINKER_FLAGS": "-flto"
      }
    },
    {
      "name": "pgo-generate",
      "displayName": "PGO Instrumentation Build (Step 1 of 2)",
      "description": "PGO workflow step 1: Build with -fprofile-generate, then run the benchmark to collect profile data. Profile data is written to build/pgo-profiles/. Next, rebuild with the pgo-use preset.",
      "inherits": ["flags-mingw", "ci-std", "cmake-pedantic"],
      "binaryDir": "${sourceDir}/build/pgo-generate",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "-fprofile-generate=${sourceDir}/build/pgo-profiles -O2 -Wall -Wextra -Wpedantic",
        "CMAKE_EXE_LINKER_FLAGS": "-fprofile-generate=${sourceDir}/build/pgo-profiles"
      }
    },
    {
      "name": "pgo-use",
      "displayName": "PGO Optimized Build (Step 2 of 2)",
      "description": "PGO workflow step 2: Build with -fprofile-use to apply collected profile data from build/pgo-profiles/. Requires a prior pgo-generate build and benchmark run. Full PGO workflow: (1) cmake --preset pgo-generate && cmake --build build/pgo-generate, (2) ./build/pgo-generate/videopac_benchmark --bios <bios> <rom> --frames 6000, (3) cmake --preset pgo-use && cmake --build build/pgo-use.",
      "inherits": ["flags-mingw", "ci-std", "cmake-pedantic"],
      "binaryDir": "${sourceDir}/build/pgo-use",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "-fprofile-use=${sourceDir}/build/pgo-profiles -O2 -Wall -Wextra -Wpedantic",
        "CMAKE_EXE_LINKER_FLAGS": "-fprofile-use=${sourceDir}/build/pgo-profiles"
      }
    }
  ]
}
